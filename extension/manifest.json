{
  "manifest_version": 3,
  "name": "Applications",
  "version": "1.0",
  "description": "Track filled applications",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_icon": "assets/logo/LOGO.png",
    "default_title": "My Applications" 
  },
  "side_panel": {
        "default_path": "sidePanel.html"
  }
}